# ==============================================================================
# Library Book Reservation System — Environment Configuration
# ==============================================================================

# Core Database Configuration
DATABASE_URL=sqlite:///./library.db
RESERVATION_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Gmail SMTP Configuration for User Credentials, Password Resets & Out-of-Stock Alerts
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Generate 16-character App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=your_email@gmail.com
ENABLE_LIVE_EMAIL=true

# Groq Cloud AI Recommendation Key (100% Free Tier available)
# Generate key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Admin Account Credentials for Initial Access
ADMIN_EMAIL=admin@library.com
ADMIN_DEFAULT_PASSWORD=AdminPass123!
